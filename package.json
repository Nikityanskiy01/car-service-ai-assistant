{
  "name": "car-service-ai-assistant",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run prisma:generate",
    "start": "npm --prefix backend run start",
    "seed:demo": "npm --prefix backend run db:seed:demo",
    "test": "npm run test:frontend && npm run test:backend",
    "test:ai": "npm --prefix backend run test:ai && npm --prefix frontend run test:ai",
    "test:ai:integration": "npm --prefix backend run test:ai",
    "test:ai:e2e": "playwright test tests/e2e/ai-consultation-timeout-regression.spec.js",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "npm --prefix backend run test",
    "test:e2e": "playwright test",
    "test:eval": "npm --prefix backend run test:eval",
    "test:eval:live": "npm --prefix backend run test:eval:live",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "format": "prettier --write \"backend/src/**/*.{ts,js,mjs}\" \"frontend/src/**/*.{ts,tsx}\" \"*.md\"",
    "format:check": "prettier --check \"package.json\" \"CONTRIBUTING.md\" \"LICENSE\"",
    "routes:inventory": "npm --prefix backend exec -- tsx scripts/list-api-routes.mjs --write",
    "routes:check": "npm --prefix backend exec -- tsx scripts/list-api-routes.mjs --check",
    "openapi:sync": "node backend/scripts/sync-openapi.mjs",
    "openapi:check": "node backend/scripts/sync-openapi.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.1",
    "concurrently": "^9.2.0",
    "lefthook": "^1.13.6",
    "prettier": "^3.9.6"
  }
}
