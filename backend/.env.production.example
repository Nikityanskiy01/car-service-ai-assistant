DATABASE_URL="postgresql://car_service_app:change-this-strong-password@db:5432/car_service"
PORT=3000
NODE_ENV=production
SERVE_FRONTEND=false
JWT_SECRET="replace-with-random-64-chars-secret"
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN=https://your-domain.example
LLM_PROVIDER=openai
LLM_FALLBACK_ENABLED=true
# LLM_FALLBACK_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
# Для облачной OpenAI-compatible LLM:
# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDER=ollama
# LLM_CLOUD_BASE_URL=https://api.vsellm.ru/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen3.5-flash
LLM_MODEL=qwen3.5-flash
LLM_EXTRACTION_MODEL=qwen2.5:3b
LLM_EXTRACTION_NUM_PREDICT=280
LLM_DIAGNOSIS_MODEL=qwen2.5:7b
LLM_DIAGNOSIS_NUM_PREDICT=420
LLM_DIAGNOSIS_TIMEOUT_MS=240000
LLM_KEEP_ALIVE=30m
LLM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_IDS=
DEMO_MODE=false
DEMO_CLIENT_EMAIL=client@example.local
DEMO_CLIENT_PASSWORD=change-demo-client-password
DEMO_MANAGER_EMAIL=manager@example.local
DEMO_MANAGER_PASSWORD=change-demo-manager-password
DEMO_ADMIN_EMAIL=admin@example.local
DEMO_ADMIN_PASSWORD=change-demo-admin-password
