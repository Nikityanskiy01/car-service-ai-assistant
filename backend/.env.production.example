DATABASE_URL="postgresql://fox:change-this-strong-password@db:5432/foxmotors"
PORT=3000
NODE_ENV=production
SERVE_FRONTEND=false
JWT_SECRET="replace-with-random-64-chars-secret"
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN=https://your-domain.example
LLM_PROVIDER=ollama
LLM_FALLBACK_ENABLED=true
# LLM_FALLBACK_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434
# Для облачной OpenAI-compatible LLM:
# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDER=ollama
# LLM_CLOUD_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
LLM_MODEL=qwen2.5:7b
LLM_EXTRACTION_MODEL=qwen2.5:3b
LLM_EXTRACTION_NUM_PREDICT=280
LLM_DIAGNOSIS_MODEL=qwen2.5:7b
LLM_DIAGNOSIS_NUM_PREDICT=420
LLM_DIAGNOSIS_TIMEOUT_MS=240000
DIAGNOSIS_AGENT_MODE=llmfactory
DIAGNOSIS_AGENT_TIMEOUT_MS=90000
DIAGNOSIS_AGENT_MAX_RETRIES=1
LLM_KEEP_ALIVE=30m
LLM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_IDS=
