DATABASE_URL="postgresql://car_service_app:change-this-strong-password@db:5432/car_service"
PORT=3000
NODE_ENV=production
SERVE_FRONTEND=false
JWT_SECRET="replace-with-random-64-chars-secret-min-32"
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN=https://your-domain.example
APP_PUBLIC_URL=https://your-domain.example

LLM_PROVIDER=openai
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_CLOUD_BASE_URL=https://api.vsellm.ru/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=qwen3.5-flash
LLM_EXTRACTION_MODEL=qwen3.5-flash
LLM_DIAGNOSIS_MODEL=qwen3.5-flash
LLM_ENABLED=true
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_MS=60000
DIAGNOSIS_CACHE_ENABLED=true
DIAGNOSIS_CACHE_TTL_MS=3600000
DIAGNOSIS_CACHE_MAX_ENTRIES=200
DIAGNOSIS_QUEUE_CONCURRENCY=2
DIAGNOSIS_ASYNC_ENABLED=true
RUN_BACKGROUND_JOBS=false
REDIS_URL=redis://redis:6379
CASE_MEMORY_SEMANTIC_ENABLED=true
CASE_MEMORY_TOP_K=5
CASE_MEMORY_LEXICAL_FALLBACK=true
CONSULTATION_FEEDBACK_FEW_SHOT_ENABLED=true
CONSULTATION_FEEDBACK_FEW_SHOT_LIMIT=3

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MANAGER_CHAT_IDS=
INTEGRATION_ENCRYPTION_KEY=replace-with-random-64-chars-min-32

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Автоассистент <noreply@your-domain.example>
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
OTP_CODE_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

OTEL_SERVICE_NAME=car-service-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=false
