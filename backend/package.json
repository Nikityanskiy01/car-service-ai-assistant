{
  "name": "car-service-ai-assistant-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "prisma migrate deploy && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:eval": "node scripts/run-consultation-eval.js",
    "test:ai": "npm run test:ai:safety && npm run test:ai:scenarios && npm run test:ai:access && npm run test:ai:stability",
    "test:ai:safety": "npm run test -- tests/unit/ai-safety.test.js --runInBand",
    "test:ai:scenarios": "npm run test -- tests/integration/ai-consultation-scenarios.test.js --runInBand",
    "test:ai:access": "npm run test -- tests/integration/ai-consultation-access-and-persistence.test.js --runInBand",
    "test:ai:stability": "npm run test -- tests/integration/ai-observability-and-stability.test.js --runInBand",
    "lint": "eslint src tests",
    "llm:check": "node scripts/llm-check.js",
    "llm:bench": "node scripts/llm-latency-benchmark.js",
    "case-memory:backfill": "node scripts/case-memory-backfill.js",
    "smoke:consultation": "node scripts/smoke-consultation.js",
    "prices:build": "node scripts/build-price-catalog.js",
    "stats:build": "node scripts/build-work-stats.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "node prisma/seed.demo.js",
    "db:bootstrap:prod": "node scripts/bootstrap-prod-users.mjs",
    "db:studio": "prisma studio",
    "db:ensure-test": "node scripts/ensure-test-database.mjs",
    "db:setup": "node scripts/db-setup.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.18.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
