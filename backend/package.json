{
  "name": "car-service-ai-assistant-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec \"tsx src/server.ts\"",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:eval": "node scripts/run-consultation-eval.js",
    "test:eval:live": "tsx scripts/run-live-llm-eval.js",
    "test:ai": "npm run test:ai:safety && npm run test:ai:scenarios && npm run test:ai:access && npm run test:ai:stability",
    "test:ai:safety": "npm run test -- tests/unit/ai-safety.test.js --runInBand",
    "test:ai:scenarios": "npm run test -- tests/integration/ai-consultation-scenarios.test.js --runInBand",
    "test:ai:access": "npm run test -- tests/integration/ai-consultation-access-and-persistence.test.js --runInBand",
    "test:ai:stability": "npm run test -- tests/integration/ai-observability-and-stability.test.js --runInBand",
    "lint": "eslint src tests && tsc --noEmit",
    "llm:check": "tsx scripts/llm-check.js",
    "llm:bench": "tsx scripts/llm-latency-benchmark.js",
    "case-memory:backfill": "tsx scripts/case-memory-backfill.js",
    "smoke:consultation": "tsx scripts/smoke-consultation.js",
    "prices:build": "node scripts/build-price-catalog.js",
    "stats:build": "node scripts/build-work-stats.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "tsx prisma/seed.demo.js",
    "db:seed:inbox": "node prisma/seed.inbox.demo.js",
    "db:bootstrap:prod": "node scripts/bootstrap-prod-users.mjs",
    "db:studio": "prisma studio",
    "db:ensure-test": "node scripts/ensure-test-database.mjs",
    "db:setup": "node scripts/db-setup.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.18.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pngjs": "^7.0.0",
    "prisma": "^6.5.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "telegraf": "^4.16.3",
    "tsx": "^4.20.5",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.17.0",
    "@types/nodemailer": "^6.4.19",
    "@types/pdfkit": "^0.17.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  }
}
