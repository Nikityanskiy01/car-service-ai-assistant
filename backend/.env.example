# Локально: PostgreSQL из docker-compose в корне репозитория (postgres:16)
DATABASE_URL="postgresql://car_service_app:change-me@localhost:5433/car_service"
PORT=3000
NODE_ENV=development
SERVE_FRONTEND=true
JWT_SECRET="change-me-in-production-min-32-chars-long!!"
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_DAYS=7
# В development CORS разрешает любой origin (см. app.js) — удобно для http://127.0.0.1 и http://192.168.x.x:3000
# В production обязателен точный origin фронта
CORS_ORIGIN=http://localhost:3000
LLM_PROVIDER=ollama
LLM_FALLBACK_ENABLED=true
# LLM_FALLBACK_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:11434
# Для облачной OpenAI-compatible LLM:
# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDER=ollama
# LLM_CLOUD_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
LLM_MODEL=qwen2.5:7b
# Быстрая модель для извлечения полей (рекомендуется легче основной):
LLM_EXTRACTION_MODEL=qwen2.5:3b
# LLM_EXTRACTION_NUM_PREDICT=280
# Модель для итогового диагноза (тяжелее / точнее):
LLM_DIAGNOSIS_MODEL=qwen2.5:7b
# LLM_DIAGNOSIS_NUM_PREDICT=420
# Таймаут диагноза (мс) и keep_alive модели в Ollama:
# LLM_DIAGNOSIS_TIMEOUT_MS=240000
# LLM_KEEP_ALIVE=30m
# Для отладки: принудительно ходить в LLM даже для "простых" сообщений.
# LLM_FORCE_EXTRACTION=true
# Установите false для работы без LLM (rule-based fallback)
LLM_ENABLED=true
# Embeddings для семантической памяти кейсов (Ollama: nomic-embed-text)
# LLM_EMBEDDING_MODEL=nomic-embed-text
# CASE_MEMORY_SEMANTIC_ENABLED=true
# CASE_MEMORY_TOP_K=5
# CASE_MEMORY_LEXICAL_FALLBACK=true
# Few-shot примеры из оценок менеджеров в промпт диагноза
# CONSULTATION_FEEDBACK_FEW_SHOT_ENABLED=true
# CONSULTATION_FEEDBACK_FEW_SHOT_LIMIT=3
# Circuit breaker при сбоях LLM
# LLM_CIRCUIT_BREAKER_ENABLED=true
# LLM_CIRCUIT_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_COOLDOWN_MS=60000
# Кэш похожих диагнозов (hash симптомы+марка+модель)
# DIAGNOSIS_CACHE_ENABLED=true
# DIAGNOSIS_CACHE_TTL_MS=3600000
# DIAGNOSIS_CACHE_MAX_ENTRIES=200
# Очередь диагнозов (in-memory, concurrency)
# DIAGNOSIS_QUEUE_CONCURRENCY=2
# Асинхронный диагноз через BullMQ (нужен REDIS_URL)
# DIAGNOSIS_ASYNC_ENABLED=true
# REDIS_URL=redis://127.0.0.1:6379
# LLM_VISION_MODEL=llava
# LLM_VISION_TIMEOUT_MS=90000
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_IDS=
# Ключ шифрования credentials интеграций (в production обязателен, >=32 символов)
INTEGRATION_ENCRYPTION_KEY=replace-with-random-64-chars-min-32

# Тесты: отдельная БД
TEST_DATABASE_URL="postgresql://car_service_app:change-me@localhost:5433/car_service_test"

# Опционально: полный путь к .ttf с кириллицей для экспорта PDF (иначе ищутся системные DejaVu/Arial)
# PDF_BODY_FONT=
# Название в шапке PDF-отчётов (по умолчанию «Автоассистент»)
# PDF_BRAND_NAME=
