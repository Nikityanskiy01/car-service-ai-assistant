# Локально: PostgreSQL из docker-compose в корне репозитория (postgres:16, user/pass fox, БД foxmotors)
DATABASE_URL="postgresql://fox:fox@localhost:5433/foxmotors"
PORT=3000
NODE_ENV=development
SERVE_FRONTEND=true
JWT_SECRET="change-me-in-production-min-32-chars-long!!"
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_DAYS=7
# В development CORS разрешает любой origin (см. app.js) — удобно для http://127.0.0.1 и http://192.168.x.x:3000
# В production обязателен точный origin фронта
CORS_ORIGIN=http://localhost:3000
LLM_PROVIDER=openai
LLM_FALLBACK_ENABLED=false
LLM_CLOUD_BASE_URL=https://api.vsellm.ru/v1
LLM_API_KEY=vsellm_xxx
LLM_MODEL=qwen/qwen3-coder-next
# Быстрее извлечение полей (опционально; иначе та же модель):
# LLM_EXTRACTION_MODEL=qwen2.5:3b
# LLM_EXTRACTION_NUM_PREDICT=280
# Модель для итогового диагноза (опционально; иначе LLM_MODEL):
# LLM_DIAGNOSIS_MODEL=qwen2.5:7b
# LLM_DIAGNOSIS_NUM_PREDICT=420
# Таймаут диагноза (мс) и keep_alive:
# LLM_DIAGNOSIS_TIMEOUT_MS=240000
# Режимы LLM-first rollout:
# CONSULTATION_FLOW_MODE=hybrid
# DIAGNOSIS_MODE=hybrid
# DIAGNOSIS_TURN_BUDGET_MS=20000
# DIAGNOSIS_MIN_REMAINING_MS=6000
# DIAGNOSIS_FAST_PATH_ENABLED=true
# DIAGNOSIS_COMPLEXITY_THRESHOLD=4
# Режим движка диагностики:
# DIAGNOSIS_AGENT_MODE=llmfactory
# DIAGNOSIS_AGENT_PROFILE=compact
# DIAGNOSIS_AGENT_USE_HINTS=false
# DIAGNOSIS_AGENT_TIMEOUT_MS=90000
# DIAGNOSIS_AGENT_MAX_RETRIES=1
# SSE_HEARTBEAT_MS=25000
# LLM_KEEP_ALIVE=30m
# Установите false для работы без LLM (rule-based fallback)
LLM_ENABLED=true

# Тесты: отдельная БД (создаётся `npm run db:ensure-test` при запущенном Docker или init-скриптом тома)
TEST_DATABASE_URL="postgresql://fox:fox@localhost:5433/foxmotors_test"

# Опционально: полный путь к .ttf с кириллицей для экспорта PDF (иначе ищутся системные DejaVu/Arial)
# PDF_BODY_FONT=
# Название в шапке PDF-отчётов (по умолчанию «Автоассистент»)
# PDF_BRAND_NAME=
