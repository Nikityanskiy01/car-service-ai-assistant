generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  MANAGER
  ADMINISTRATOR
}

enum PreferredContact {
  PHONE
  EMAIL
  TELEGRAM
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  CLOSED
}

enum ServiceRequestStatus {
  NEW
  IN_PROGRESS
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ConsultationSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  AI_ERROR
}

enum ConsultationMessageSender {
  USER
  ASSISTANT
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ARRIVED
  NO_SHOW
  CANCELLED
}

enum IntegrationProvider {
  ONE_C
  AUTODEALER_DESKTOP
  AUTODEALER_WEB
  AUTODEALER_ONLINE
  BITRIX24
  AMOCRM
  YCLIENTS
  MOYSKLAD
  MEGAPLAN
  GENERIC_REST
  GENERIC_WEBHOOK
  FILE_EXCHANGE
}

enum IntegrationConnectionStatus {
  NOT_CONFIGURED
  REQUIRES_SETUP
  TESTING
  CONNECTED
  LIMITED
  AUTH_ERROR
  UNAVAILABLE
  PAUSED
}

enum IntegrationJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYING
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum IntegrationConflictStatus {
  OPEN
  RESOLVED_LOCAL
  RESOLVED_EXTERNAL
  RESOLVED_MERGED
  POSTPONED
}

enum IntegrationDirection {
  OUTBOUND
  INBOUND
  BIDIRECTIONAL
}

enum IntegrationSourceOfTruth {
  LOCAL
  EXTERNAL
  LATEST_UPDATE
  MANUAL_CONFIRMATION
}

enum IntegrationOutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ConsultationFeedbackVerdict {
  CORRECT
  PARTIAL
  INCORRECT
}

enum ConsultationDiagnosisJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String
  emailProfile String?  @map("email_profile")
  avatarUrl    String?  @map("avatar_url")
  city         String?
  telegram     String?
  preferredContact PreferredContact? @map("preferred_contact")
  role         Role     @default(CLIENT)
  blocked      Boolean  @default(false)
  tokenVersion Int      @default(0) @map("token_version")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  telegramChatId  String?   @unique @map("telegram_chat_id")
  telegramLinkedAt DateTime? @map("telegram_linked_at")
  loginEmailOtpEnabled Boolean @default(true) @map("login_email_otp_enabled")
  loginSmsEnabled      Boolean @default(false) @map("login_sms_enabled")
  loginTelegramEnabled Boolean @default(false) @map("login_telegram_enabled")
  totpSecretEnc   String?   @map("totp_secret_enc") @db.Text
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  totpBackupHashes String[] @default([]) @map("totp_backup_hashes")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  consultationSessions ConsultationSession[]
  serviceRequests      ServiceRequest[]      @relation("ClientRequests")
  followUpMessages     RequestFollowUpMessage[]
  consultationReports  ConsultationReport[]
  serviceBookings      ServiceBooking[]
  serviceBookingAudits ServiceBookingAuditLog[] @relation("BookingAuditActor")
  adminAuditEvents     AdminAuditEvent[]        @relation("AdminAuditActor")
  siteContentVersions  SiteContentVersion[]     @relation("SiteContentVersionActor")
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  emailVerificationCodes EmailVerificationCode[]
  consultationFeedbacks ConsultationFeedback[]
  assignedServiceRequests ServiceRequest[] @relation("AssignedManagerRequests")
  serviceRequestStatusLogs ServiceRequestStatusLog[]
  clientVehicles           ClientVehicle[]
  clientVehicleExclusions  ClientVehicleExclusion[]
  clientServiceRecords     VehicleServiceRecord[] @relation("ClientServiceRecords")
  createdServiceRecords    VehicleServiceRecord[] @relation("ServiceRecordCreator")
  loginEvents              UserLoginEvent[]
  authOtpChallenges        AuthOtpChallenge[]
  notificationPreference   UserNotificationPreference?
  inboxNotifications       InboxNotification[]
  uploadedCompletionDocuments ServiceRequestCompletionDocument[] @relation("CompletionDocumentUploader")
  consentEvents                ConsentEvent[]

  @@index([phone])
  @@map("users")
}

model ConsentEvent {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  subjectKey    String   @map("subject_key")
  purpose       String
  policyVersion String   @map("policy_version")
  ip            String?
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectKey])
  @@index([createdAt(sort: Desc)])
  @@map("consent_events")
}

model UserNotificationPreference {
  userId           String   @id @map("user_id")
  bookingReminders Boolean  @default(true) @map("booking_reminders")
  messageAlerts    Boolean  @default(true) @map("message_alerts")
  marketing        Boolean  @default(false)
  channelEmail     Boolean  @default(true) @map("channel_email")
  channelTelegram  Boolean  @default(true) @map("channel_telegram")
  channelSms       Boolean  @default(false) @map("channel_sms")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model InboxNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  kind      String
  title     String
  body      String
  href      String?
  dedupeKey String    @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries InboxNotificationDelivery[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("inbox_notifications")
}

model InboxNotificationDelivery {
  id             String   @id @default(uuid())
  notificationId String   @map("notification_id")
  channel        String
  status         String
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")

  notification InboxNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("inbox_notification_deliveries")
}

model AuthOtpChallenge {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  purpose     String
  channel     String
  destination String
  codeHash    String    @map("code_hash")
  token       String    @unique
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_otp_challenges")
}

model UserLoginEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  success   Boolean
  method    String   @default("password") // password | totp | backup
  ip        String?
  userAgent String?  @map("user_agent") @db.Text
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_login_events")
}

model ClientVehicleExclusion {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  fingerprint String
  createdAt   DateTime @default(now()) @map("created_at")

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, fingerprint])
  @@index([clientId])
  @@map("client_vehicle_exclusions")
}

model ClientVehicle {
  id               String   @id @default(uuid())
  clientId         String   @map("client_id")
  make             String
  model            String
  year             Int?
  vin              String?
  notes            String?
  source           String   @default("manual")
  currentMileageKm Int?     @map("current_mileage_km")
  photoUrl         String?  @map("photo_url")
  licensePlate     String?  @map("license_plate")
  color            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client               User                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultationSessions ConsultationSession[]
  serviceRequests      ServiceRequest[]
  serviceRecords       VehicleServiceRecord[]
  bookings             ServiceBooking[]

  @@index([clientId])
  @@map("client_vehicles")
}

/** Сервисная книжка: выполненные работы по авто (ТО, замена масла, ЗН). */
model VehicleServiceRecord {
  id                     String    @id @default(uuid())
  vehicleId              String    @map("vehicle_id")
  clientId               String    @map("client_id")
  performedAt            DateTime  @map("performed_at")
  mileageKm              Int?      @map("mileage_km")
  title                  String
  category               String    @default("other")
  worksDone              String?   @map("works_done")
  workOrderNumber        String?   @map("work_order_number")
  amountMinor            Int?      @map("amount_minor")
  source                 String    @default("client_manual")
  serviceRequestId       String?   @map("service_request_id")
  consultationFeedbackId String?   @map("consultation_feedback_id")
  createdById            String?   @map("created_by_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  vehicle              ClientVehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  client               User                  @relation("ClientServiceRecords", fields: [clientId], references: [id], onDelete: Cascade)
  createdBy            User?                 @relation("ServiceRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  serviceRequest       ServiceRequest?       @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  consultationFeedback ConsultationFeedback? @relation(fields: [consultationFeedbackId], references: [id], onDelete: SetNull)

  @@index([vehicleId, performedAt(sort: Desc)])
  @@index([clientId, performedAt(sort: Desc)])
  @@index([category, vehicleId])
  @@index([consultationFeedbackId])
  @@map("vehicle_service_records")
}

model ServiceRequestStatusLog {
  id         String   @id @default(uuid())
  requestId  String   @map("request_id")
  actorId    String?  @map("actor_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  createdAt  DateTime @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt(sort: Desc)])
  @@map("service_request_status_logs")
}

model SiteContentBlock {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  section     String   @default("general")
  content     String
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions SiteContentVersion[]

  @@index([section, updatedAt(sort: Desc)])
  @@map("site_content_blocks")
}

model SiteContentVersion {
  id        String   @id @default(uuid())
  blockId   String   @map("block_id")
  content   String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  block SiteContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  actor User?            @relation("SiteContentVersionActor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([blockId, createdAt(sort: Desc)])
  @@map("site_content_versions")
}

model AdminAuditEvent {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("admin_audit_events")
}

model SiteSettings {
  id         String   @id @default("default")
  configJson Json     @map("config_json")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  @@map("site_settings")
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions           ConsultationSession[]
  referenceMaterials ReferenceMaterial[]

  @@map("service_categories")
}

model ConsultationScenario {
  id          String   @id @default(uuid())
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  questions ConsultationQuestion[]
  hints     Hint[]

  @@map("consultation_scenarios")
}

model ConsultationQuestion {
  id         String   @id @default(uuid())
  scenarioId String   @map("scenario_id")
  order      Int      @default(0)
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  scenario ConsultationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@map("consultation_questions")
}

model Hint {
  id         String   @id @default(uuid())
  scenarioId String?  @map("scenario_id")
  text       String
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  scenario ConsultationScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@map("hints")
}

model ReferenceMaterial {
  id         String   @id @default(uuid())
  title      String
  body       String
  categoryId String?  @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("reference_materials")
}

model ConsultationSession {
  id                String                    @id @default(uuid())
  clientId          String?                   @map("client_id")
  vehicleId         String?                   @map("vehicle_id")
  guestToken        String?                   @unique @map("guest_token")
  guestName         String?                   @map("guest_name")
  guestPhone        String?                   @map("guest_phone")
  serviceCategoryId String?                   @map("service_category_id")
  status            ConsultationSessionStatus @default(IN_PROGRESS)
  progressPercent   Int                       @default(0) @map("progress_percent")
  confidencePercent Int?                      @map("confidence_percent")
  costFromMinor     Int?                      @map("cost_from_minor")
  preliminaryNote   String?                   @map("preliminary_note")
  /** JSON: { asked_questions: { field, question }[], stage: "clarification" | "result" } */
  flowState           Json?                     @map("flow_state")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  client          User?                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle         ClientVehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  serviceCategory ServiceCategory?       @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  messages        Message[]
  extracted       ExtractedDiagnosticData?
  recommendations DiagnosticRecommendation[]
  caseEmbedding        ConsultationCaseEmbedding?
  feedback        ConsultationFeedback?
  diagnosisJob    ConsultationDiagnosisJob?
  serviceRequest  ServiceRequest?
  reports         ConsultationReport[]

  @@index([clientId])
  @@index([vehicleId])
  @@index([createdAt])
  @@index([status])
  @@index([updatedAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("consultation_sessions")
}

model Message {
  id        String                    @id @default(uuid())
  sessionId String                    @map("session_id")
  sender    ConsultationMessageSender
  content   String
  createdAt DateTime                  @default(now()) @map("created_at")

  session ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("messages")
}

model ExtractedDiagnosticData {
  sessionId         String  @id @map("session_id")
  make              String?
  model             String?
  year              Int?
  mileage           Int?
  symptoms          String?
  problemConditions String? @map("problem_conditions")
  obdCodes          String? @map("obd_codes")
  session ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("extracted_diagnostic_data")
}

model DiagnosticRecommendation {
  id                 String   @id @default(uuid())
  sessionId          String   @map("session_id")
  title              String
  probabilityPercent Int      @map("probability_percent")
  createdAt          DateTime @default(now()) @map("created_at")

  session ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("diagnostic_recommendations")
}

/** Семантический индекс завершённых консультаций для case memory (RAG-lite). */
model ConsultationCaseEmbedding {
  sessionId          String   @id @map("session_id")
  symptomCategory    String?  @map("symptom_category")
  make               String?
  model              String?
  topRecommendations Json     @default("[]") @map("top_recommendations")
  costFromMinor      Int?     @map("cost_from_minor")
  /** JSON-массив float — fallback cosine в Node, если нет pgvector. */
  embedding          Json
  /** pgvector ANN; пишется raw SQL (см. lib/pgvector.js). */
  embeddingVec       Unsupported("vector(768)")? @map("embedding_vec")
  dimensions         Int      @default(768)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  session ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([symptomCategory])
  @@index([updatedAt(sort: Desc)])
  @@map("consultation_case_embeddings")
}

/** Оценка менеджером точности ИИ-диагноза после обработки заявки. */
model ConsultationFeedback {
  id          String                      @id @default(uuid())
  sessionId   String                      @unique @map("session_id")
  managerId   String                      @map("manager_id")
  verdict     ConsultationFeedbackVerdict
  actualCause String?                     @map("actual_cause")
  worksDone   String?                     @map("works_done")
  repairAmountMinor Int?                  @map("repair_amount_minor")
  workOrderNumber   String?               @map("work_order_number")
  repairCompletedAt DateTime?             @map("repair_completed_at")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  session        ConsultationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  manager        User                    @relation(fields: [managerId], references: [id], onDelete: Restrict)
  serviceRecords VehicleServiceRecord[]

  @@index([managerId])
  @@index([verdict])
  @@index([createdAt(sort: Desc)])
  @@index([verdict, updatedAt(sort: Desc)])
  @@map("consultation_feedback")
}

/** Асинхронная задача LLM-диагноза (BullMQ + Redis). */
model ConsultationDiagnosisJob {
  id           String                         @id @default(uuid())
  sessionId    String                         @unique @map("session_id")
  status       ConsultationDiagnosisJobStatus @default(PENDING)
  payloadJson  Json                           @map("payload_json")
  resultJson   Json?                          @map("result_json")
  errorMessage String?                        @map("error_message")
  bullJobId    String?                        @map("bull_job_id")
  createdAt    DateTime                       @default(now()) @map("created_at")
  updatedAt    DateTime                       @updatedAt @map("updated_at")

  session ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@map("consultation_diagnosis_jobs")
}

model ServiceRequest {
  id                    String                 @id @default(uuid())
  clientId              String?                @map("client_id")
  vehicleId             String?                @map("vehicle_id")
  guestName             String?                @map("guest_name")
  guestPhone            String?                @map("guest_phone")
  guestEmail            String?                @map("guest_email")
  consultationSessionId String                 @unique @map("consultation_session_id")
  status                ServiceRequestStatus   @default(NEW)
  version               Int                    @default(1)
  snapshotMake          String?                @map("snapshot_make")
  snapshotModel         String?                @map("snapshot_model")
  snapshotSymptoms      String?                @map("snapshot_symptoms")
  assignedManagerId     String?                @map("assigned_manager_id")
  firstResponseAt       DateTime?              @map("first_response_at")
  clientMessagesReadAt  DateTime?              @map("client_messages_read_at")
  staffMessagesReadAt   DateTime?              @map("staff_messages_read_at")
  slaNotifiedAt         DateTime?              @map("sla_notified_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  client              User?                    @relation("ClientRequests", fields: [clientId], references: [id], onDelete: SetNull)
  vehicle             ClientVehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedManager     User?                    @relation("AssignedManagerRequests", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  consultationSession ConsultationSession      @relation(fields: [consultationSessionId], references: [id], onDelete: Cascade)
  followUpMessages    RequestFollowUpMessage[]
  notifications       Notification[]
  bookings            ServiceBooking[]
  statusLogs          ServiceRequestStatusLog[]
  serviceRecords      VehicleServiceRecord[]
  completionDocuments ServiceRequestCompletionDocument[]

  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@index([assignedManagerId])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("service_requests")
}

model RequestFollowUpMessage {
  id        String   @id @default(uuid())
  requestId String   @map("request_id")
  authorId  String   @map("author_id")
  body      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  request     ServiceRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author      User                        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments RequestFollowUpAttachment[]

  @@index([requestId])
  @@index([requestId, createdAt])
  @@map("request_follow_up_messages")
}

model RequestFollowUpAttachment {
  id           String   @id @default(uuid())
  messageId    String   @map("message_id")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at")

  message RequestFollowUpMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("request_follow_up_attachments")
}

/** Документы выдачи клиенту после ремонта (ЗН, чек, гарантия). */
model ServiceRequestCompletionDocument {
  id           String   @id @default(uuid())
  requestId    String   @map("request_id")
  kind         String
  label        String?
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @map("storage_key")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("CompletionDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt(sort: Desc)])
  @@map("service_request_completion_documents")
}

model Notification {
  id              String             @id @default(uuid())
  serviceRequestId String            @map("service_request_id")
  payload         String
  status          NotificationStatus @default(PENDING)
  attempts        Int                @default(0)
  lastError       String?            @map("last_error")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@map("notifications")
}

model ConsultationReport {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  consultationSessionId String   @map("consultation_session_id")
  snapshotJson          Json     @map("snapshot_json")
  label                 String?
  createdAt             DateTime @default(now()) @map("created_at")

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ConsultationSession @relation(fields: [consultationSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consultation_reports")
}

model ServiceBooking {
  id               String        @id @default(uuid())
  clientId         String?       @map("client_id")
  vehicleId        String?       @map("vehicle_id")
  guestName        String?       @map("guest_name")
  guestPhone       String?       @map("guest_phone")
  guestEmail       String?       @map("guest_email")
  serviceRequestId String?       @map("service_request_id")
  preferredAt      DateTime      @map("preferred_at")
  status           BookingStatus @default(PENDING)
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  client         User?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle        ClientVehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  auditLogs      ServiceBookingAuditLog[]

  @@index([clientId])
  @@index([vehicleId])
  @@index([serviceRequestId])
  @@index([preferredAt])
  @@index([clientId, preferredAt])
  @@map("service_bookings")
}

/** Журнал правок записи в сервис (для администратора). */
model ServiceBookingAuditLog {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  actorId   String   @map("actor_id")
  changes   Json     @map("changes")
  createdAt DateTime @default(now()) @map("created_at")

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User           @relation("BookingAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt(sort: Desc)])
  @@map("service_booking_audit_logs")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  familyId   String    @default(uuid()) @map("family_id")
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  ip         String?
  userAgent  String?   @map("user_agent") @db.Text
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationCode {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verification_codes")
}

/** Сообщения с публичной формы «Контакты» (location.html). */
model ContactSubmission {
  id                 String                  @id @default(uuid())
  fullName           String                  @map("full_name")
  phone              String
  message            String?
  source             String                  @default("contact_form")
  status             ContactSubmissionStatus @default(NEW)
  processedAt        DateTime?               @map("processed_at")
  convertedRequestId String?                 @map("converted_request_id")
  closedReason       String?                 @map("closed_reason")
  createdAt          DateTime                @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("contact_submissions")
}

model IntegrationConnection {
  id               String                    @id @default(uuid())
  tenantId         String                    @default("default") @map("tenant_id")
  name             String
  provider         IntegrationProvider
  versionLabel     String?                   @map("version_label")
  mode             String                    @default("api")
  status           IntegrationConnectionStatus @default(REQUIRES_SETUP)
  enabled          Boolean                   @default(false)
  capabilitiesJson Json?                     @map("capabilities_json")
  configJson       Json?                     @map("config_json")
  lastSyncAt       DateTime?                 @map("last_sync_at")
  lastErrorCode    String?                   @map("last_error_code")
  lastErrorMessage String?                   @map("last_error_message")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  credentials    IntegrationCredential[]
  statusMappings IntegrationStatusMapping[]
  jobs           IntegrationJob[]
  links          ExternalEntityLink[]
  webhookEvents  IntegrationWebhookEvent[]
  conflicts      IntegrationConflict[]
  auditEvents    IntegrationAuditEvent[]
  cursors        IntegrationSyncCursor[]
  outboxEvents   IntegrationOutboxEvent[]

  @@index([tenantId, provider])
  @@index([tenantId, status])
  @@map("integration_connections")
}

model IntegrationCredential {
  id             String   @id @default(uuid())
  connectionId   String   @map("connection_id")
  key            String
  encryptedValue String   @map("encrypted_value")
  maskedValue    String   @map("masked_value")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, key])
  @@map("integration_credentials")
}

model IntegrationStatusMapping {
  id            String                 @id @default(uuid())
  connectionId  String                 @map("connection_id")
  entityType    String                 @map("entity_type")
  internalStatus String                @map("internal_status")
  externalStatus String                @map("external_status")
  direction     IntegrationDirection   @default(BIDIRECTIONAL)
  sourceOfTruth IntegrationSourceOfTruth @default(MANUAL_CONFIRMATION)
  description   String?
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, entityType, internalStatus, externalStatus])
  @@map("integration_status_mappings")
}

model IntegrationJob {
  id               String              @id @default(uuid())
  connectionId     String              @map("connection_id")
  eventType        String              @map("event_type")
  entityType       String              @map("entity_type")
  entityId         String              @map("entity_id")
  idempotencyKey   String              @map("idempotency_key")
  status           IntegrationJobStatus @default(PENDING)
  attemptCount     Int                 @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?           @map("next_attempt_at")
  lastErrorCode    String?             @map("last_error_code")
  lastErrorMessage String?             @map("last_error_message")
  payloadJson      Json?               @map("payload_json")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  attempts   IntegrationAttempt[]

  @@unique([connectionId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
  @@map("integration_jobs")
}

model IntegrationAttempt {
  id           String   @id @default(uuid())
  jobId         String   @map("job_id")
  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  success       Boolean  @default(false)
  errorCode     String?  @map("error_code")
  errorMessage  String?  @map("error_message")
  httpStatus    Int?     @map("http_status")
  durationMs    Int?     @map("duration_ms")

  job IntegrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt(sort: Desc)])
  @@map("integration_attempts")
}

model ExternalEntityLink {
  id                 String   @id @default(uuid())
  connectionId       String   @map("connection_id")
  internalEntityType String   @map("internal_entity_type")
  internalEntityId   String   @map("internal_entity_id")
  externalEntityType String   @map("external_entity_type")
  externalEntityId   String   @map("external_entity_id")
  externalUrl        String?  @map("external_url")
  synchronizedAt     DateTime @default(now()) @map("synchronized_at")
  externalVersion    String?  @map("external_version")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, internalEntityType, internalEntityId, externalEntityType])
  @@index([connectionId, externalEntityId])
  @@map("external_entity_links")
}

model IntegrationWebhookEvent {
  id             String   @id @default(uuid())
  connectionId   String   @map("connection_id")
  eventId        String?  @map("event_id")
  payloadJson    Json?    @map("payload_json")
  headersJson    Json?    @map("headers_json")
  signatureValid Boolean  @default(false) @map("signature_valid")
  status         String   @default("RECEIVED")
  errorMessage   String?  @map("error_message")
  receivedAt     DateTime @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, receivedAt(sort: Desc)])
  @@map("integration_webhook_events")
}

model IntegrationConflict {
  id               String                    @id @default(uuid())
  connectionId     String                    @map("connection_id")
  entityType       String                    @map("entity_type")
  internalEntityId String                    @map("internal_entity_id")
  externalEntityId String?                   @map("external_entity_id")
  field            String
  localValue       String?                   @map("local_value")
  externalValue    String?                   @map("external_value")
  status           IntegrationConflictStatus @default(OPEN)
  resolutionNote   String?                   @map("resolution_note")
  resolvedAt       DateTime?                 @map("resolved_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status])
  @@index([entityType, internalEntityId])
  @@map("integration_conflicts")
}

model IntegrationAuditEvent {
  id           String   @id @default(uuid())
  connectionId String?  @map("connection_id")
  level        String   @default("INFO")
  action       String
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  payloadJson  Json?    @map("payload_json")
  createdAt    DateTime @default(now()) @map("created_at")

  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([connectionId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("integration_audit_events")
}

model IntegrationSyncCursor {
  id           String   @id @default(uuid())
  connectionId String   @map("connection_id")
  cursorKey    String   @map("cursor_key")
  cursorValue  String?  @map("cursor_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, cursorKey])
  @@map("integration_sync_cursors")
}

model IntegrationOutboxEvent {
  id             String                 @id @default(uuid())
  connectionId   String                 @map("connection_id")
  eventType      String                 @map("event_type")
  entityType     String                 @map("entity_type")
  entityId       String                 @map("entity_id")
  idempotencyKey String                 @map("idempotency_key")
  payloadJson    Json?                  @map("payload_json")
  status         IntegrationOutboxStatus @default(PENDING)
  errorMessage   String?                @map("error_message")
  createdAt      DateTime               @default(now()) @map("created_at")
  processedAt    DateTime?              @map("processed_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@unique([connectionId, idempotencyKey])
  @@map("integration_outbox_events")
}
