# LLM для локального CLI Strix. Не коммитить ключи.
# Скопируйте нужные строки в shell или в ~/.strix/cli-config.json
# (Strix сам сохраняет конфиг после первого запуска).

# Рекомендуется frontier-модель с tool calling (пентест-агенты иначе «глупеют»):
STRIX_LLM=openai/gpt-5.4
LLM_API_KEY=

# VseLLM / любой OpenAI-compatible шлюз:
# STRIX_LLM=openai/qwen3.5-flash
# LLM_API_BASE=https://api.vsellm.ru/v1
# LLM_API_KEY=

# Локальный Ollama (только если данные нельзя отдавать в облако).
# qwen2.5:7b для Strix слишком мал — нужен модель с нормальным tool calling.
# STRIX_LLM=ollama/qwen3-vl
# LLM_API_BASE=http://127.0.0.1:11434

# Облако app.strix.ai вместо локального Docker (токен: Settings → API Access):
# STRIX_API_TOKEN=
