[Unit]
Description=Car Service deploy/update stack
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=carservice
Group=carservice
WorkingDirectory=/opt/car-service-ai-assistant
ExecStart=/usr/bin/bash /opt/car-service-ai-assistant/deploy/proxmox/deploy.sh main
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
