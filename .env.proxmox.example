# Bind порты только на loopback; наружу публикует Nginx (80/443).
FRONTEND_BIND_ADDR=127.0.0.1
FRONTEND_PORT=8080
BACKEND_BIND_ADDR=127.0.0.1
BACKEND_PORT=3000

POSTGRES_USER=car_service_app
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=car_service

# Модель, которую подтянет контейнер Ollama при запуске.
LLM_MODEL=qwen2.5:7b

# Публичный URL сайта (ссылки в письмах сброса пароля)
APP_PUBLIC_URL=https://autoservice-demo.zernov.online

# SMTP (по умолчанию в Docker — Mailpit; для production укажите свой сервер)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Автоассистент <noreply@example.com>

# Веб-интерфейс Mailpit (только для dev/demo)
MAILPIT_SMTP_BIND=127.0.0.1:1025
MAILPIT_UI_BIND=127.0.0.1:8025
